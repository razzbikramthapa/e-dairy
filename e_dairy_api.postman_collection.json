					},
					"response": []
				}
			]
		},
		{
			"name": "Milk Collection CRUD",
			"item": [
				{
					"name": "Add Milk Record",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"farmer\": 2,\n    \"session\": \"morning\",\n    \"quantity\": \"42.50\",\n    \"fat\": \"4.80\",\n    \"snf\": \"8.50\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/collection/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"collection",
								""
							]
						},
						"description": "Submits a new milk collection log for a farmer. The rate per litre and total amount calculations are computed automatically by the backend (JWT Protected)."
					},
					"response": []
				},
				{
					"name": "Get Collections Log",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/collection/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"collection",
								""
							]
						},
						"description": "Lists milk records. If logged in as a Farmer, returns only their own logs; if an Agent, returns all logs (JWT Protected)."
					},
					"response": []
				}
			]
		},
